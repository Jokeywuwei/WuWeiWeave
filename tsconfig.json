{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": {
      "@wuweiweave/core": ["./packages/core/src/index.ts"],
      "@wuweiweave/ui-web/server": ["./packages/ui-web/src/server/server.ts"],
      "@wuweiweave/ui-tui": ["./packages/ui-tui/src/index.ts"],
      "@wuweiweave/pi-mcp-adapter": ["./packages/libs/pi-mcp-adapter/src/index.ts"]
    },
    "skipLibCheck": true
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
