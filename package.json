{
  "name": "wuweiweave",
  "version": "0.155",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/libs/*"
  ],
  "scripts": {
    "install": "echo \"Use bun install from the repository root\"",
    "start": "bun run web",
    "web": "bun run --cwd packages/ui-web dev",
    "dev": "bun run web",
    "tui": "bun run --cwd packages/ui-tui start",
    "cli": "bun run --cwd apps/cli start",
    "bootstrap": "bun run scripts/bootstrap-state.ts",
    "docker:build": "bun run scripts/build-runtime-image.ts",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:provider": "bun run scripts/smoke-provider.ts",
    "smoke:docker": "bun run scripts/smoke-docker.ts",
    "smoke:product": "bun run scripts/smoke-productization.ts",
    "smoke:reliability": "bun run scripts/smoke-reliability.ts",
    "smoke:operations": "bun run scripts/smoke-operations.ts",
    "smoke:acceptance": "bun run scripts/smoke-acceptance.ts",
    "worker": "bun run scripts/worker-daemon.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "bun run --cwd packages/ui-web build",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.2.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
